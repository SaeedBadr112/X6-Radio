{
  "appId": "com.saeed.x6radio",
  "appName": "X6 Radio",
  "webDir": "www",
  "backgroundColor": "#0a192f",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0a192f"
  },
  "android": {
    "backgroundColor": "#0a192f",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0a192f",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a192f"
    }
  }
}
